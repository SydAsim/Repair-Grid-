# ==============================================================================
# REPAIRGRID: Environment Configuration Example
# ==============================================================================

# Application Environment
APP_ENV=development # development | staging | production | test
ORGANIZATION_ID=campus-district-01
PORT=3000

# AWS Core Configuration
AWS_REGION=us-east-1
BEDROCK_REGION=us-east-1

# Bedrock Models & AgentCore (Configurable - Never Hardcoded)
PRIMARY_MODEL=us.amazon.nova-2-lite-v1:0
AGENTCORE_RUNTIME_ENABLED=false
ENABLE_LOCAL_AGENT_MOCK=true # Runs Strands Graph & deterministic policies locally for zero cloud cost testing

# Amazon DynamoDB Tables
DYNAMODB_REPORTS_TABLE=RepairGridReports
DYNAMODB_MISSIONS_TABLE=RepairGridMissions
DYNAMODB_WORKERS_TABLE=RepairGridWorkers
DYNAMODB_DECISIONS_TABLE=RepairGridDecisions
DYNAMODB_EVENTS_TABLE=RepairGridEvents
DYNAMODB_CONNECTIONS_TABLE=RepairGridConnections

# Amazon S3 Private Evidence Storage
S3_EVIDENCE_BUCKET=repairgrid-evidence-demo
S3_PRESIGNED_EXPIRATION_SECONDS=900

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=us-east-1_mockpool
COGNITO_CLIENT_ID=mockclientid1234567890

# Amazon Location Service
LOCATION_MAP_NAME=RepairGridCampusMap
LOCATION_PLACE_INDEX=RepairGridPlaceIndex
LOCATION_ROUTE_CALCULATOR=RepairGridRouteCalculator

# Realtime WebSocket Endpoints
NEXT_PUBLIC_WS_URL=ws://localhost:3001
WEBSOCKET_API_ENDPOINT=wss://mock-ws.repairgrid.demo
WEBSOCKET_MANAGEMENT_ENDPOINT=https://mock-ws.repairgrid.demo

# Autonomous Policy Thresholds
POLICY_AUTO_DUPLICATE_THRESHOLD=0.95
POLICY_AUTO_ASSIGNMENT_THRESHOLD=0.90
POLICY_AUTO_CLOSURE_THRESHOLD=0.90
POLICY_SAFETY_CRITICAL_AUTO_CLOSE=NEVER
POLICY_CRITICAL_RESOURCE_REASSIGNMENT=HUMAN
